{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peek Remote",
  "version": "0.2.3",
  "identifier": "dev.gaster4432.peekremote",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Peek Remote",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "bundleVCRuntime": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
